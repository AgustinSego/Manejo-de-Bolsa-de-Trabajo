@startuml
skinparam classAttributeIconSize 0

class Main {
    + {static} main(args : String[]) : void
}

class InterfazUsuario {
  - emp : ManejoEmpresa
  - postulante : ManejoPostulantes
  - V : Ventana
  - imprimir : Impresora
  - gestorBolsa : GestorBolsaTrabajo
  + InterfazUsuario()
  + ventana() : void
  + leerEntero() : int
  + consola() : void
}

class Ventana {
  - emp : ManejoEmpresa
  - pos : ManejoPostulantes
  + Ventana()
  + menuAgregar() : void
  + menuMostrar() : void
  + menuEditar() : void
  + menuEliminar() : void
  + menuBuscar() : void
  + realizarContratacion() : void
  + ...(...)
}

class Impresora {
  + principal() : void
  + menuAgregar() : void
  + menuMostrar() : void
  + menuEditar() : void
  + menuEliminar() : void
  + menuBuscar() : void
}

class ManejoEmpresa {
  - lectorCsv : LecturaProcesamientoCsv
  - keys : ArrayList<String>
  - mapa : HashMap<String, ArrayList<Empresa>>
  - mensajeError : String
  + ManejoEmpresa()
  + obtenerLista(campo : String) : ArrayList<Empresa>
  + existe(vacante : String) : boolean
  + mostrarVacantes() : void
  + eliminar(vacante : String) : void
  + eliminar(empresa : String, a : String) : void
  + agregar(empresa : Empresa) : void
  + mostrar() : void
  + edicion(nombre : String, nombreCambiar : String) : void
  + edicion(empresa : String, sueldoCambiar : int, vacante : String) : void
  + buscarList(nombreEmpresa : String) : void
  + buscarMap(Vacante : String) : void
  + getMensajeError() : String
}

class ManejoPostulantes {
  - lectorCsv : LecturaProcesamientoCsv
  - keys : ArrayList<String>
  - mapa : HashMap<String, ArrayList<Postulante>>
  - mensajeError : String
  + ManejoPostulantes()
  + obtenerLista(campo : String) : ArrayList<Postulante>
  + eliminar(postulante : String) : void
  + agregar(persona : Postulante) : void
  + mostrar() : void
  + edicion(nombre : String, nombreCambiar : String) : void
  + edicion(nombre : String, sueldoSolicitadoCambiar : int, vacante : String) : void
  + buscarList(nombrePostulante : String) : void
  + buscarMap(vacante : String) : void
  + getMensajeError() : String
}

class GestorBolsaTrabajo {
  + GestorBolsaTrabajo()
  + porcentajeCompatibilidad(p : Postulante, puesto : Empresa) : double
  + realizarContratacion(empresa : Empresa, manejoPos : ManejoPostulantes, manejoEmp : ManejoEmpresa) : Postulante
  + mostrarHistorialContrataciones() : void
}

class Empresa {
  - nombreEmpresa : String
  - nombreVacante : String
  - campoLaboralRequerido : String
  - sueldo : int
  - experienciaRequerida : int
  + Empresa(...)
  + getNombreEmpresa() : String
  + getNombreVacante() : String
  + getCampoLaboralRequerido() : String
  + getSueldo() : int
  + getExperienciaRequerida() : int
  + setNombreEmpresa(nombre : String) : void
  + setNombreVacante(vacante : String) : void
  + setCampoLaboralRequerido(campo : String) : void
  + setSueldo(sueldo : int) : void
  + setExperienciaRequerida(exp : int) : void
  + mostrarEmpresaInfoVacante() : void
}

class Postulante {
  - nombre : String
  - campoLaboral : String
  - rut : String
  - experiencia : int
  - edad : int
  - sueldoSolicitado : int
  + Postulante(...)
  + getNombre() : String
  + getRut() : String
  + getCampoLaboral() : String
  + getExperiencia() : int
  + getEdad() : int
  + getSueldoSolicitado() : int
  + setNombre(nombre : String) : void
  + setCampoLaboral(campo : String) : void
  + setRut(rut : String) : void
  + setExperiencia(exp : int) : void
  + setEdad(edad : int) : void
  + setSueldoSolicitado(sueldo : int) : void
  + mostrarPostulanteInfoPersonal() : void
  + mostrarPostulanteInfoVacante() : void
}

interface InterfazGestion<T> {
  + eliminar(...) : void
  + agregar(...) : void
  + mostrar(...) : void
  + edicion(...) : void
  + buscarList(...) : void
  + buscarMap(...) : void
}

class LecturaProcesamientoCsv {
  + leerCsv(...) : void
}

class Exception {
}

class DatosInvalidosException {
  + DatosInvalidosException(mensaje : String)
}

class ElementosNoEncontradosException {
  + ElementosNoEncontradosException(mensaje : String)
}

Main --> InterfazUsuario

InterfazUsuario --> Ventana : coordina
InterfazUsuario --> Impresora : usa
InterfazUsuario --> ManejoEmpresa : gestiona
InterfazUsuario --> ManejoPostulantes : gestiona
InterfazUsuario --> GestorBolsaTrabajo : ejecuta

Ventana --> ManejoEmpresa
Ventana --> ManejoPostulantes

GestorBolsaTrabajo --> ManejoPostulantes : usa
GestorBolsaTrabajo --> ManejoEmpresa : usa
GestorBolsaTrabajo ..> Postulante : usa
GestorBolsaTrabajo ..> Empresa : usa

ManejoEmpresa ..|> InterfazGestion : <<implementa>>
ManejoPostulantes ..|> InterfazGestion : <<implementa>>

ManejoEmpresa --> Empresa : gestiona
ManejoEmpresa --> LecturaProcesamientoCsv : usa

ManejoPostulantes --> Postulante : gestiona
ManejoPostulantes --> LecturaProcesamientoCsv : usa

ManejoEmpresa ..> DatosInvalidosException : <<lanzan>>
ManejoEmpresa ..> ElementosNoEncontradosException : <<lanzan>>

ManejoPostulantes ..> DatosInvalidosException : <<lanzan>>
ManejoPostulantes ..> ElementosNoEncontradosException : <<lanzan>>

DatosInvalidosException --|> Exception : extiende
ElementosNoEncontradosException --|> Exception : extiende

@enduml
