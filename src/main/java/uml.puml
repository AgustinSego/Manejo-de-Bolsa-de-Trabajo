@startuml

class Main

class InterfazUsuario {
    -empresa : ManejoEmpresa
    -postulante : ManejoPostulantes
    -v : Ventana
    -imprimir : Impresora
    -gestorBolsa : GestorBolsaTrabajo

    +InterfazUsuario()
    +ventana()
    +leerEntero(..)
    +consola()
}

class Ventana {
    -emp : ManejoEmpresa
    -pos : ManejoPostulantes

    +Ventana(...)
    +menuAgregar()
    +menuMostrar()
    +menuEditar()
    +menuEliminar()
    +menuBuscar()
    +realizarContratacion()
}

class Impresora

class Postulante {
    -nombre : String
    -campoLaboral : String
    -rut : String
    -experiencia : int
    -edad : int
    -sueldoSolicitado : int

    +Postulante(...)
    +getNombre() : String
    +getRut() : String
    +getCampoLaboral() : String
    +getExperiencia() : int
    +getEdad() : int
    +getSueldoSolicitado() : int
}

class Empresa {
    -nombreEmpresa : String
    -nombreVacante : String
    -campoLaboralRequerido : String
    -sueldo : int
    -experenciaRequerida : int

    +Empresa(...)
    +getNombreEmpresa() : String
    +getNombreVacante() : String
    +getCampoLaboralRequerido() : String
    +getSueldo() : int
    +getExperienciaRequerida() : int
}

interface InterfazGestion<T> {
    +eliminar(...)
    +agregar(...)
    +mostrar(...)
    +edicion(...)
    +buscarList(...)
    +buscarMap(...)
}

class ManejoPostulantes {
    -lectorCsv : LecturaProcesamientoCsv
    -keys : ArrayList<String>
    -mapa : HashMap<String, ArrayList<Postulante>>
    -mensajeError : String
}

class ManejoEmpresa {
    -lectorCsv : LecturaProcesamientoCsv
    -keys : ArrayList<String>
    -mapa : HashMap<String, ArrayList<Empresa>>
    -mensajeError : String
}

class LecturaProcesamientoCsv

class GestorBolsaTrabajo {
    +porcentajeCompatibilidad(...)
    +realizarContratacion(...)
    +mostrarHistorialContrataciones()
}

class DatosInvalidosException
class ElementosNoEncontradosException

' Herencia de excepciones
DatosInvalidosException --|> Exception
ElementosNoEncontradosException --|> Exception

' Implementación de interfaz
ManejoPostulantes ..|> InterfazGestion
ManejoEmpresa ..|> InterfazGestion

' Manejo de excepciones
ManejoPostulantes ..> DatosInvalidosException
ManejoPostulantes ..> ElementosNoEncontradosException

ManejoEmpresa ..> DatosInvalidosException
ManejoEmpresa ..> ElementosNoEncontradosException

' Relaciones principales
Main --> InterfazUsuario

InterfazUsuario --> Ventana
InterfazUsuario --> ManejoPostulantes
InterfazUsuario --> ManejoEmpresa
InterfazUsuario --> GestorBolsaTrabajo
InterfazUsuario --> Impresora

Ventana --> ManejoPostulantes
Ventana --> ManejoEmpresa
Ventana --> GestorBolsaTrabajo

ManejoPostulantes --> Postulante
ManejoEmpresa --> Empresa

ManejoPostulantes --> LecturaProcesamientoCsv
ManejoEmpresa --> LecturaProcesamientoCsv

GestorBolsaTrabajo --> Postulante
GestorBolsaTrabajo --> Empresa

@enduml
